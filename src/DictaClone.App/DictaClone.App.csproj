<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../DictaClone.Audio/DictaClone.Audio.csproj" />
    <ProjectReference Include="../DictaClone.Core/DictaClone.Core.csproj" />
    <ProjectReference Include="../DictaClone.Infrastructure/DictaClone.Infrastructure.csproj" />
    <ProjectReference Include="../DictaClone.Speech/DictaClone.Speech.csproj" />
    <ProjectReference Include="../DictaClone.Text/DictaClone.Text.csproj" />
    <ProjectReference Include="../DictaClone.Windows/DictaClone.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../legal/THIRD-PARTY-NOTICES.md"
          Link="THIRD-PARTY-NOTICES.md"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../legal/MODEL-LICENSES.md"
          Link="MODEL-LICENSES.md"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../docs/RELEASE_NOTES.md"
          Link="RELEASE_NOTES.md"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../docs/ROLLBACK.md"
          Link="ROLLBACK.md"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../docs/CLEAN_ROOM_INSTALLATION.md"
          Link="CLEAN_ROOM_INSTALLATION.md"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
